<Window x:Class="Notizbuch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Notizbuch"
        xmlns:models="clr-namespace:Notizbuch.Models"
        Title="Notizbuch"
        MinWidth="600"
        MinHeight="400"
        Icon="Bilder/Notizbuch.ico">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="0.75cm"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40*"/>
            <ColumnDefinition Width="60*"/>
        </Grid.ColumnDefinitions>

        <!-- HEADER -->

        <StackPanel Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    Margin="10"
                    HorizontalAlignment="Center">

            <Image Source="Bilder/Notizbuch.png"
                   Height="32"
                   Margin="0 0 10 0"/>

            <TextBlock FontSize="16"
                       FontWeight="Bold"
                       Foreground="Green">
                Notizen
            </TextBlock>

            <TextBlock Text="Kategorie"
                       FontSize="14"
                       VerticalAlignment="Center"
                       Margin="100 0 5 0"/>

            <ComboBox Name="cbxKategorie"
                      Width="200"
                      FontSize="14"
                      SelectedIndex="0"
                      SelectionChanged="cbxKategorie_SelectionChanged"/>
        </StackPanel>

        <!-- SEARCH -->

        <DockPanel Grid.Row="1">

            <Label DockPanel.Dock="Left"
                   Content="Suchtext"
                   VerticalAlignment="Center"/>

            <Button Name="btnSucheAufheben"
                    DockPanel.Dock="Right"
                    Content="X"
                    FontWeight="Bold"
                    Background="Red"
                    Foreground="White"
                    Click="btnSuche_Click"/>

            <Button Name="btnSuche"
                    DockPanel.Dock="Right"
                    Content="Suchen"
                    Click="btnSuche_Click"/>

            <TextBox Name="tbxSuche"/>

        </DockPanel>

        <!-- LISTBOX -->

        <ListBox Name="lbxNotizen"
                 Grid.Row="2"
                 SelectionChanged="lbxNotizen_SelectionChanged"
                 ItemsSource="{Binding}">

            <ListBox.Resources>
                <local:DatumKonverter x:Key="Datum"/>
            </ListBox.Resources>

            <ListBox.ItemTemplate>

                <DataTemplate>

                    <StackPanel Orientation="Horizontal">

                        <TextBlock
                            Text="{Binding ErstelltAm, Converter={StaticResource Datum}}"
                            Foreground="{Binding ErstelltAm, Converter={StaticResource Datum}, ConverterParameter=vordergrund}"
                            Background="{Binding ErstelltAm, Converter={StaticResource Datum}, ConverterParameter=hintergrund}"
                            FontSize="10"/>

                        <TextBlock Text="{Binding Kategorie}"
                                   FontSize="10"
                                   Width="60"
                                   Margin="5,0"/>

                        <TextBlock Text="{Binding Inhalt}"/>

                    </StackPanel>

                </DataTemplate>

            </ListBox.ItemTemplate>

        </ListBox>

        <!-- NOTE TEXT -->

        <TextBox Name="tbxNotiz"
                 Grid.Row="1"
                 Grid.RowSpan="2"
                 Grid.Column="1"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Visible"
                 FontFamily="Comic Sans MS"
                 TextChanged="tbxNotiz_TextChanged"/>

        <!-- BUTTONS -->

        <DockPanel Grid.Row="3"
                   Grid.ColumnSpan="2"
                   LastChildFill="False">

            <Button Name="btnNeu"
                    DockPanel.Dock="Left"
                    Content="Neu"
                    Click="btnNeu_Click"/>

            <Button Name="btnLöschen"
                    DockPanel.Dock="Left"
                    Content="Löschen"
                    Click="btnLöschen_Click"/>

            <Button Name="btnSpeichern"
                    DockPanel.Dock="Left"
                    Content="Speichern"
                    Click="btnSpeichern_Click"/>

            <Button Name="btnBeenden"
                    DockPanel.Dock="Right"
                    Content="Beenden"
                    Click="btnBeenden_Click"/>

        </DockPanel>

    </Grid>
</Window>