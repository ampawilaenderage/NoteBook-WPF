<Window x:Class="Notizbuch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Notizbuch"
        Title="Notizbuch" MinWidth="600" MinHeight="400">

    <Grid>
        <!-- ROWS -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- StackPanel -->
            <RowDefinition Height="30"/>    <!-- DockPanel: Search -->
            <RowDefinition Height="*"/>     <!-- Content: ListBox + TextBox -->
            <RowDefinition Height="0.75cm"/> <!-- DockPanel: Buttons -->
        </Grid.RowDefinitions>

        <!-- COLUMNS -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40*"/> <!-- ListBox / left -->
            <ColumnDefinition Width="60*"/> <!-- TextBox / right -->
        </Grid.ColumnDefinitions>

        <!-- TOP STACKPANEL -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <TextBlock FontWeight="Bold" FontSize="16" Foreground="Green">
                Notizen<LineBreak/>
                <Span FontSize="10" FontWeight="Light">
                
                </Span>
            </TextBlock>
            <TextBlock Text="Kategorie" FontSize="14" Foreground="DarkGray" VerticalAlignment="Center" Margin="100 0 5 0"/>
            <ComboBox Name="cbxKategorie" Width="200" FontSize="14" SelectedIndex="0" VerticalContentAlignment="Center" Padding="10 0" SelectionChanged="cbxKategorie_SelectionChanged">
            </ComboBox>
        </StackPanel>

        <!-- SEARCH DOCKPANEL -->
        <DockPanel Grid.Row="1">
            <Label DockPanel.Dock="Left" Content="Suchtext" VerticalAlignment="Center"/>
            <Button Name="btnSucheAufheben" DockPanel.Dock="Right" Content="X" FontWeight="Bold" Background="Red" Foreground="White" Click="btnSucheAufheben_Click"/>
            <Button Name="btnSuche" DockPanel.Dock="Right" Content="Suchen" Click="btnSuche_Click"/>
            <TextBox Name="tbxSuche"/>
        </DockPanel>

        <!-- LISTBOX & TEXTBOX -->
        <ListBox Name="lbxNotizen" Grid.Row="2" Grid.Column="0" DisplayMemberPath="Inhalt" SelectionChanged="lbxNotizen_SelectionChanged"/>
        <TextBox Name="tbxNotiz" Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Background="LightYellow" IsEnabled="False" AcceptsReturn="True" VerticalScrollBarVisibility="Visible" FontFamily="Comic Sans MS" TextChanged="tbxNotiz_TextChanged"/>

        <!-- BUTTONS DOCKPANEL -->
        <DockPanel Grid.Row="3" Grid.ColumnSpan="2" LastChildFill="False">
            <Button Name="btnNeu" DockPanel.Dock="Left" Content="Neu" IsEnabled="False" Click="btnNeu_Click"/>
            <Button Name="btnLöschen" DockPanel.Dock="Left" Content="Löschen" IsEnabled="False" Click="btnLöschen_Click"/>
            <Button Name="btnSpeichern" DockPanel.Dock="Left" Content="Speichern" IsEnabled="False" Click="btnSpeichern_Click"/>
            <Button Name="btnBeenden" DockPanel.Dock="Right" Content="Beenden" Click="btnBeenden_Click"/>
        </DockPanel>

    </Grid>
</Window>